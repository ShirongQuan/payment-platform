  <diagram name="Page-1" id="mE8HFklQZJqYrmR3LhGd">
    <mxGraphModel dx="2330" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\tautonumber\n\tactor Client\n\tparticipant AC as Auth&lt;br/&gt;Controller\n\tparticipant AS as Authorisation&lt;br/&gt;ServiceImpl\n\tparticipant ATE as Authorisation&lt;br/&gt;Transactional&lt;br/&gt;ExecutorImpl\n\tparticipant AR as Authorisation&lt;br/&gt;Repository\n\tparticipant AER as Authorisation&lt;br/&gt;EventRepository\n\tparticipant AccR as Account&lt;br/&gt;Repository\n\tparticipant OES as OutboxEvent&lt;br/&gt;ServiceImpl\n\n\tClient-&gt;&gt;AC: POST /authorisations/{id}/reversals\n\tAC-&gt;&gt;AS: reverse(authorisationId,&lt;br/&gt;reverseRequest)\n\tAS-&gt;&gt;ATE: reverseInTransaction(authorisationId,&lt;br/&gt;reverseRequest, correlationId)\n\n\tATE-&gt;&gt;AR: findById(authorisationId)\n\tAR--&gt;&gt;ATE: AuthorisationEntity\n\n\talt status == REVERSED\n\t\tATE-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_REVERSED)\n\t\talt reverse event exists for idempotency key\n\t\t\tAER--&gt;&gt;ATE: existing reverse event\n\t\t\tATE--&gt;&gt;AS: previous ReverseResponse\n\t\telse key mismatch / no matching event\n\t\t\tATE--&gt;&gt;AS: throw AuthorisationIllegalStateException&lt;br/&gt;(already REVERSED)\n\t\tend\n\telse status != AUTHORISED\n\t\tATE--&gt;&gt;AS: throw AuthorisationIllegalStateException&lt;br/&gt;(e.g. CAPTURED/DECLINED)\n\telse status == AUTHORISED\n\t\tATE-&gt;&gt;AccR: findById(accountId)\n\t\tAccR--&gt;&gt;ATE: AccountEntity\n\t\tATE-&gt;&gt;ATE: account.reverse(amount, currency)\n\t\tNote over ATE: reservedBalance -= amount only -&lt;br/&gt;availableBalance untouched (funds were never debited from it)\n\t\tATE-&gt;&gt;ATE: set authorisation status = REVERSED\n\n\t\tATE-&gt;&gt;AR: saveAndFlush(authorisation REVERSED)\n\t\tATE-&gt;&gt;AER: saveAndFlush(event AUTHORISATION_REVERSED,&lt;br/&gt;reasonCode)\n\t\tATE-&gt;&gt;OES: enqueueAuthorisation(...,&lt;br/&gt;OperationType.REVERSE)\n\t\tOES-&gt;&gt;OES: build REVERSE payload map\n\t\tOES-&gt;&gt;OES: save outbox event (status NEW)\n\t\tATE--&gt;&gt;AS: ReverseResponse\n\tend\n\n\talt Concurrent idempotency race\n\t\tATE--&gt;&gt;AS: throw ConcurrentIdempotencyRaceException\n\t\tAS-&gt;&gt;AR: findById(authorisationId)\n\t\tAS-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_REVERSED)\n\t\talt reverse event found\n\t\t\tAS--&gt;&gt;AC: recovered ReverseResponse\n\t\telse\n\t\t\tAS--&gt;&gt;AC: IdempotencyConflictException\n\t\tend\n\telse Concurrent account-version race&lt;br/&gt;(different idempotency key)\n\t\tATE--&gt;&gt;AS: throw AccountConcurrencyConflictException\n\t\tAS--&gt;&gt;AC: 409 Conflict (retry hint)\n\telse No race\n\t\tAS--&gt;&gt;AC: ReverseResponse\n\tend\n\n\tAC--&gt;&gt;Client: 200 OK / error\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bawoS82YUG5GsbfKegBj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;labelBackgroundColor=none;" vertex="1">
