  <diagram name="Page-1" id="ifW_A47DgU6R7isG1K4V">
    <mxGraphModel dx="2082" dy="1354" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\tautonumber\n\tactor Client\n\tparticipant AC as Auth&lt;br/&gt;Controller\n\tparticipant AS as Authorisation&lt;br/&gt;ServiceImpl\n\tparticipant Cache as Idempotency&lt;br/&gt;Cache (Redis)\n\tparticipant ATE as Authorisation&lt;br/&gt;Transactional&lt;br/&gt;ExecutorImpl\n\tparticipant AR as Authorisation&lt;br/&gt;Repository\n\tparticipant AER as Authorisation&lt;br/&gt;EventRepository\n\tparticipant AccR as Account&lt;br/&gt;Repository\n\tparticipant OES as OutboxEvent&lt;br/&gt;ServiceImpl\n\n\tClient-&gt;&gt;AC: POST /authorisations/{id}/reversals\n\tAC-&gt;&gt;AS: reverse(authorisationId,&lt;br/&gt;reverseRequest)\n\tAS-&gt;&gt;Cache: get(REVERSE, authorisationId,&lt;br/&gt;idempotencyKey)\n\talt Cache hit (fingerprint matches)\n\t\tCache--&gt;&gt;AS: cached ReverseResponse\n\t\tAS--&gt;&gt;AC: replayed response&lt;br/&gt;(no DB call)\n\telse Cache miss\n\t\tCache--&gt;&gt;AS: miss\n\t\tAS-&gt;&gt;ATE: reverseInTransaction(authorisationId,&lt;br/&gt;reverseRequest, correlationId)\n\n\t\tATE-&gt;&gt;AR: findById(authorisationId)\n\t\tAR--&gt;&gt;ATE: AuthorisationEntity\n\n\t\talt status == REVERSED\n\t\t\tATE-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_REVERSED)\n\t\t\talt reverse event exists for idempotency key\n\t\t\t\tAER--&gt;&gt;ATE: existing reverse event\n\t\t\t\tATE--&gt;&gt;AS: previous ReverseResponse\n\t\t\telse key mismatch / no matching event\n\t\t\t\tATE--&gt;&gt;AS: throw AuthorisationIllegalStateException&lt;br/&gt;(already REVERSED)\n\t\t\tend\n\t\telse status != AUTHORISED\n\t\t\tATE--&gt;&gt;AS: throw AuthorisationIllegalStateException&lt;br/&gt;(e.g. CAPTURED/DECLINED)\n\t\telse status == AUTHORISED\n\t\t\tATE-&gt;&gt;AccR: findById(accountId)\n\t\t\tAccR--&gt;&gt;ATE: AccountEntity\n\t\t\tATE-&gt;&gt;ATE: account.reverse(amount, currency)\n\t\t\tNote over ATE: reservedBalance -= amount only -&lt;br/&gt;availableBalance untouched (funds were never debited from it)\n\t\t\tATE-&gt;&gt;ATE: set authorisation status = REVERSED\n\n\t\t\tATE-&gt;&gt;AR: saveAndFlush(authorisation REVERSED)\n\t\t\tATE-&gt;&gt;AER: saveAndFlush(event AUTHORISATION_REVERSED,&lt;br/&gt;reasonCode)\n\t\t\tATE-&gt;&gt;OES: enqueueAuthorisation(...,&lt;br/&gt;OperationType.REVERSE)\n\t\t\tOES-&gt;&gt;OES: build REVERSE payload map\n\t\t\tOES-&gt;&gt;OES: save outbox event (status NEW)\n\t\t\tATE--&gt;&gt;AS: ReverseResponse\n\t\tend\n\n\t\talt Concurrent idempotency race\n\t\t\tATE--&gt;&gt;AS: throw ConcurrentIdempotencyRaceException\n\t\t\tAS-&gt;&gt;AR: findById(authorisationId)\n\t\t\tAS-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_REVERSED)\n\t\t\talt reverse event found\n\t\t\t\tAS-&gt;&gt;Cache: store response (TTL)\n\t\t\t\tAS--&gt;&gt;AC: recovered ReverseResponse\n\t\t\telse\n\t\t\t\tAS--&gt;&gt;AC: IdempotencyConflictException\n\t\t\tend\n\t\telse Concurrent account-version race&lt;br/&gt;(different idempotency key)\n\t\t\tATE--&gt;&gt;AS: throw AccountConcurrencyConflictException\n\t\t\tAS--&gt;&gt;AC: 409 Conflict (retry hint)\n\t\telse No race\n\t\t\tAS-&gt;&gt;Cache: store response (TTL)\n\t\t\tAS--&gt;&gt;AC: ReverseResponse\n\t\tend\n\tend\n\n\tAC--&gt;&gt;Client: 200 OK / error\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="idC1ZhUw8JpmjgZeiH-5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
