  <diagram name="Page-1" id="UbLt5jr-C6_8xOWt3kwG">
    <mxGraphModel dx="1609" dy="1067" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\tautonumber\n\tparticipant Kafka as Kafka topic:&lt;br/&gt;auth.events\n\tparticipant LCons as Ledger&lt;br/&gt;KafkaConsumer\n\tparticipant Hdr as Kafka&lt;br/&gt;HeaderReader\n\tparticipant LProc as Ledger&lt;br/&gt;EventProcessor\n\tparticipant AuthH as Authorisation&lt;br/&gt;AuthorisedHandler\n\tparticipant CapH as Authorisation&lt;br/&gt;CapturedHandler\n\tparticipant RevH as Authorisation&lt;br/&gt;ReversedHandler\n\tparticipant PRepo as ProcessedEvent&lt;br/&gt;Repository\n\tparticipant LLog as LedgerEventLog&lt;br/&gt;Repository\n\tparticipant LEntry as LedgerEntry&lt;br/&gt;Repository\n\n\tKafka--&gt;&gt;LCons: consume record(key,&lt;br/&gt;value, headers)\n\tLCons-&gt;&gt;Hdr: read(headers)\n\tHdr--&gt;&gt;LCons: EventMetadata\n\tLCons-&gt;&gt;LProc: process(metadata, rawPayload)\n\n\talt eventType == AUTHORISATION_AUTHORISED\n\t\tLProc-&gt;&gt;AuthH: handle(metadata, rawPayload)\n\t\tAuthH-&gt;&gt;PRepo: tryInsertProcessedEvent(eventId,&lt;br/&gt;type, processedAt)\n\t\talt first-time event\n\t\t\tAuthH-&gt;&gt;LLog: save(event log)\n\t\t\tAuthH-&gt;&gt;LEntry: save(ledger entry)\n\t\telse duplicate\n\t\t\tNote over AuthH,PRepo: skip duplicate event\n\t\tend\n\telse eventType == AUTHORISATION_CAPTURED\n\t\tLProc-&gt;&gt;CapH: handle(metadata, rawPayload)\n\t\tCapH-&gt;&gt;PRepo: tryInsertProcessedEvent(eventId,&lt;br/&gt;type, processedAt)\n\t\talt first-time event\n\t\t\tCapH-&gt;&gt;LLog: save(event log)\n\t\t\tCapH-&gt;&gt;LEntry: save(ledger entry)\n\t\telse duplicate\n\t\t\tNote over CapH,PRepo: skip duplicate event\n\t\tend\n\telse eventType == AUTHORISATION_REVERSED\n\t\tLProc-&gt;&gt;RevH: handle(metadata, rawPayload)\n\t\tRevH-&gt;&gt;PRepo: tryInsertProcessedEvent(eventId,&lt;br/&gt;type, processedAt)\n\t\talt first-time event\n\t\t\tRevH-&gt;&gt;LLog: save(event log)\n\t\t\tRevH-&gt;&gt;LEntry: save(ledger entry)\n\t\telse duplicate\n\t\t\tNote over RevH,PRepo: skip duplicate event\n\t\tend\n\telse eventType == AUTHORISATION_DECLINED\n\t\tNote over LProc: Intentional no-op - logged at debug and dropped.&lt;br/&gt;No handler, no processed_event row, no ledger entry.&lt;br/&gt;(A DECLINED authorisation never affected balances, so there is&lt;br/&gt;nothing to project.)\n\telse unsupported / unknown event type\n\t\tLProc--&gt;&gt;LCons: throw IllegalArgumentException\n\t\tNote over LCons,Kafka: Non-retryable - DefaultErrorHandler routes straight to&lt;br/&gt;auth.events.ledger.dlt via DeadLetterPublishingRecoverer\n\telse other runtime failure (e.g. DB unavailable)\n\t\tLProc--&gt;&gt;LCons: throw RuntimeException\n\t\tNote over LCons,Kafka: Retryable - retried 3x with 2s fixed backoff,&lt;br/&gt;then routed to auth.events.ledger.dlt if still failing\n\tend\n\n\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BPDdK2dlFz39Q_Hq4OXS-1">
