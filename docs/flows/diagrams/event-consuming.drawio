        <UserObject label="Intentional no-op - logged at debug and dropped.&#xa;No handler, no processed_event row, no ledger entry.&#xa;(A DECLINED authorisation never affected balances, so there is&#xa;nothing to project.)" mermaidId="n:note3" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Intentional no-op - logged at debug and dropped.&#xa;No handler, no processed_event row, no ledger entry.&#xa;(A DECLINED authorisation never affected balances, so there is&#xa;nothing to project.)" id="BPDdK2dlFz39Q_Hq4OXS-75">
