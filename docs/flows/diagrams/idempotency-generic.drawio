        <UserObject label="4) Concurrent race: two first-time requests,&#xa;same key, at the same time" mermaidId="n:note3" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="4) Concurrent race: two first-time requests,&#xa;same key, at the same time" id="BoGchFhTnOTgTzf14KKM-84">
