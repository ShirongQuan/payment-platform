        <UserObject label="2) Retry: same key + same payload -&gt; safe replay" mermaidId="n:note1" mermaidBaseStyle="html=1;fillColor=light-dark(#fff5ad,#2a2a2a);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="2) Retry: same key + same payload -&gt; safe replay" id="BoGchFhTnOTgTzf14KKM-82">
