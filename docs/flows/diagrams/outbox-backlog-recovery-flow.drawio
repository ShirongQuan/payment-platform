        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Outbox backlog recovery: detect -&gt; triage -&gt; retry -&gt; DLQ/manual replay\n%% See docs/flows/outbox-backlog-recovery.md for the full explanation.\nflowchart TD\n\tA[\&quot;Signal: auth_outbox_backlog rising,\\nauth_outbox_publish_attempts_total{result=failed} &gt; 0,\\nor auth_outbox_publish_lag_seconds elevated\&quot;] --&gt; B[Detect]\n\tB --&gt; C[\&quot;Query outbox_event GROUP BY status\\n(FAILED rows are invisible to the backlog gauge)\&quot;]\n\tC --&gt; D{Row status?}\n\n\tD --&gt;|\&quot;PUBLISHING, claim_until &lt; now\&quot;| E[\&quot;Self-heals automatically:\\nreclaimStalePublishing() -&gt; status=NEW\&quot;]\n\tE --&gt; R\n\n\tD --&gt;|\&quot;NEW, next_attempt_at in future\&quot;| F[\&quot;Waiting on backoff schedule\\nNo action needed\&quot;]\n\n\tD --&gt;|\&quot;NEW, next_attempt_at far in past\&quot;| G[\&quot;Scheduler not polling,\\nor batch size too small\\n-&gt; investigate OutboxScheduler health\&quot;]\n\n\tD --&gt;|\&quot;FAILED, retry_count &gt;= 5\&quot;| T[Triage]\n\n\tT --&gt; H{\&quot;Root cause of last_error?\&quot;}\n\tH --&gt;|\&quot;Transient infra\\n(Kafka outage, network blip)\&quot;| I[\&quot;Confirm Kafka / infra healthy again\&quot;]\n\tH --&gt;|\&quot;Bad data / non-retryable payload\&quot;| J[\&quot;Requires code or data fix first\&quot;]\n\n\tI --&gt; K[\&quot;Manual replay:\\nUPDATE outbox_event\\nSET status=NEW, retry_count=0,\\nnext_attempt_at=now, last_error=null\\nWHERE event_id=:eventId AND status=FAILED\&quot;]\n\tJ --&gt;|\&quot;Fixed\&quot;| K\n\tJ --&gt;|\&quot;Not fixed\&quot;| L[\&quot;Leave FAILED for audit/escalation\\n(no automatic requeue exists today)\&quot;]\n\n\tK --&gt; R[\&quot;Scheduler resumes normal\\nclaim -&gt; publish -&gt; retry loop\&quot;]\n\tR --&gt; M{Published?}\n\tM --&gt;|Yes| N[\&quot;status=PUBLISHED\\nbacklog gauge decreases\&quot;]\n\tM --&gt;|\&quot;No, exhausts retries again\&quot;| T\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="v1lfoIHryp1lwcJgwG-K-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
