  <diagram name="Page-1" id="v_JlawiidwRhF42qGncb">
    <mxGraphModel dx="1652" dy="1354" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\tautonumber\n\tactor Client\n\tparticipant AC as Auth&lt;br/&gt;Controller\n\tparticipant AS as Authorisation&lt;br/&gt;ServiceImpl\n\tparticipant Cache as Idempotency&lt;br/&gt;Cache (Redis)\n\tparticipant ATE as Authorisation&lt;br/&gt;Transactional&lt;br/&gt;ExecutorImpl\n\tparticipant AR as Authorisation&lt;br/&gt;Repository\n\tparticipant AER as Authorisation&lt;br/&gt;EventRepository\n\tparticipant AccR as Account&lt;br/&gt;Repository\n\tparticipant OES as OutboxEvent&lt;br/&gt;ServiceImpl\n\n\tClient-&gt;&gt;AC: POST /authorisations/{id}/captures\n\tAC-&gt;&gt;AS: capture(authorisationId,&lt;br/&gt;captureRequest)\n\tAS-&gt;&gt;Cache: get(CAPTURE, authorisationId,&lt;br/&gt;idempotencyKey)\n\talt Cache hit (fingerprint matches)\n\t\tCache--&gt;&gt;AS: cached CaptureResponse\n\t\tAS--&gt;&gt;AC: replayed response&lt;br/&gt;(no DB call)\n\telse Cache miss\n\t\tCache--&gt;&gt;AS: miss\n\t\tAS-&gt;&gt;ATE: captureInTransaction(authorisationId,&lt;br/&gt;captureRequest)\n\n\t\tATE-&gt;&gt;AR: findById(authorisationId)\n\t\tAR--&gt;&gt;ATE: AuthorisationEntity\n\n\t\talt status == CAPTURED\n\t\t\tATE-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_CAPTURED)\n\t\t\talt capture event exists for idempotency key\n\t\t\t\tAER--&gt;&gt;ATE: existing capture event\n\t\t\t\tATE--&gt;&gt;AS: previous CaptureResponse\n\t\t\telse capture key mismatch\n\t\t\t\tATE--&gt;&gt;AS: throw IdempotencyConflictException\n\t\t\tend\n\t\telse status != AUTHORISED\n\t\t\tATE--&gt;&gt;AS: throw AuthorisationIllegalStateException\n\t\telse status == AUTHORISED\n\t\t\tATE-&gt;&gt;AccR: findById(accountId)\n\t\t\tAccR--&gt;&gt;ATE: AccountEntity\n\t\t\tATE-&gt;&gt;ATE: account.capture(amount, currency)\n\t\t\tATE-&gt;&gt;ATE: set authorisation status = CAPTURED\n\n\t\t\tATE-&gt;&gt;AR: saveAndFlush(authorisation CAPTURED)\n\t\t\tATE-&gt;&gt;AER: saveAndFlush(event AUTHORISATION_CAPTURED)\n\t\t\tATE-&gt;&gt;OES: enqueueAuthorisation(...,&lt;br/&gt;OperationType.CAPTURE)\n\t\t\tOES-&gt;&gt;OES: build CAPTURE payload map\n\t\t\tOES-&gt;&gt;OES: save outbox event (status NEW)\n\t\t\tATE--&gt;&gt;AS: CaptureResponse\n\t\tend\n\n\t\talt Concurrent capture insert race\n\t\t\tATE--&gt;&gt;AS: throw ConcurrentIdempotencyRaceException\n\t\t\tAS-&gt;&gt;AR: findById(authorisationId)\n\t\t\tAS-&gt;&gt;AER: findByAccountIdAndEventTypeAndIdempotencyKey(accountId,&lt;br/&gt;idemKey, AUTHORISATION_CAPTURED)\n\t\t\talt capture event found\n\t\t\t\tAS-&gt;&gt;Cache: store response (TTL)\n\t\t\t\tAS--&gt;&gt;AC: recovered CaptureResponse\n\t\t\telse\n\t\t\t\tAS--&gt;&gt;AC: IdempotencyConflictException\n\t\t\tend\n\t\telse Concurrent account-version conflict&lt;br/&gt;(different idempotency key)\n\t\t\tATE--&gt;&gt;AS: throw AccountConcurrencyConflictException\n\t\t\tAS--&gt;&gt;AC: 409 Conflict (retry hint)\n\t\telse No race\n\t\t\tAS-&gt;&gt;Cache: store response (TTL)\n\t\t\tAS--&gt;&gt;AC: CaptureResponse\n\t\tend\n\tend\n\n\tAC--&gt;&gt;Client: 200 OK / error\n\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1cX2LeQenqCy_9PXpTK2-1">
