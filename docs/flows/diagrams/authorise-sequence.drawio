<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="IfIQuLM91EOqKDeAKXj4">
    <mxGraphModel dx="1183" dy="772" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Client\n    participant AC as Auth&lt;br/&gt;Controller\n    participant AS as Authorisation&lt;br/&gt;ServiceImpl\n    participant Cache as Idempotency&lt;br/&gt;Cache (Redis)\n    participant AR as Authorisation&lt;br/&gt;Repository\n    participant AccR as Account&lt;br/&gt;Repository\n    participant FO as Fraud&lt;br/&gt;Orchestrator\n    participant FS as fraud-service&lt;br/&gt;(POST /fraud/check)\n    participant ATE as Authorisation&lt;br/&gt;Transactional&lt;br/&gt;ExecutorImpl\n    participant AER as Authorisation&lt;br/&gt;EventRepository\n    participant OES as OutboxEvent&lt;br/&gt;ServiceImpl\n    Client -&gt;&gt; AC: POST&lt;br/&gt;/authorisations\n    AC -&gt;&gt; AS: authorise(request,&lt;br/&gt;clientIpAddress)\n    AS -&gt;&gt; AS: normalizeAndValidateCurrency()\n    AS -&gt;&gt; Cache: get(AUTHORISE,&lt;br/&gt;accountId, idempotencyKey)\n    alt Cache hit (fingerprint matches)\n        Cache --&gt;&gt; AS: cached AuthorisationResponse\n        AS --&gt;&gt; AC: replayed response&lt;br/&gt;(no DB/fraud call)\n    else Cache miss\n        AS -&gt;&gt; AR: findByAccountIdAndAuthoriseEventTypesAndIdempotencyKey(...)\n        alt Existing row found (best-effort DB pre-check)\n            AR --&gt;&gt; AS: AuthorisationEntity\n            AS --&gt;&gt; AC: idempotent replay /&lt;br/&gt;IdempotencyConflictException\n        else No existing row\n            AS -&gt;&gt; AccR: findById(accountId)\n            AccR --&gt;&gt; AS: AccountEntity\n\n            alt account.status != ACTIVE\n                Note over AS, FO: Account-active gate: skip fraud-service call entirely for a&lt;br/&gt;LOCKED/INACTIVE account (saves the call, and guarantees a locked&lt;br/&gt;account can never slip through just because fraud-service is down)\n                AS -&gt;&gt; AS: PreAuthDecision.AccountNotActive(status)\n            else account.status == ACTIVE\n                AS -&gt;&gt; FO: evaluate(request,&lt;br/&gt;normalizedCurrency, clientIpAddress)\n                FO -&gt;&gt; FS: POST /fraud/check&lt;br/&gt;(circuit breaker +&lt;br/&gt;250ms time limiter)\n                alt fraud-service reachable\n                    FS --&gt;&gt; FO: decision APPROVE / DECLINE&lt;br/&gt;(+ riskScore, lockAccountRecommended)\n                else timeout / circuit open / error\n                    FO -&gt;&gt; FO: apply fail-open policy&lt;br/&gt;(disabled by default)\n                    FO --&gt;&gt; FO: FraudDecision.unavailable -&gt;&lt;br/&gt;decline, or approve if&lt;br/&gt;trusted+tiny amount\n                end\n                FO --&gt;&gt; AS: PreAuthDecision.FraudEvaluated(fraudDecision)\n            end\n\n            AS -&gt;&gt; ATE: authoriseInTransaction(request,&lt;br/&gt;normalizedCurrency, preAuthDecision,&lt;br/&gt;correlationId)\n            ATE -&gt;&gt; AR: findByAccountIdAndAuthoriseEventTypesAndIdempotencyKey(...)\n            Note over ATE, AR: Authoritative idempotency check-and-insert guard against a&lt;br/&gt;concurrent request that raced past the best-effort check above\n\n            alt Existing idempotent row found (race)\n                AR --&gt;&gt; ATE: AuthorisationEntity\n                ATE --&gt;&gt; AS: throw ConcurrentIdempotencyRaceException\n            else New request\n                alt PreAuthDecision.AccountNotActive\n                    ATE -&gt;&gt; ATE: build DECLINED (reason&lt;br/&gt;ACCOUNT_LOCKED / ACCOUNT_INACTIVE)\n                else fraudDecision.isDeclined()\n                    ATE -&gt;&gt; ATE: build DECLINED&lt;br/&gt;(reason FRAUD_DECLINED)\n                    opt fraudDecision.lockAccountRecommended&lt;br/&gt;&amp;&amp; account ACTIVE\n                        ATE -&gt;&gt; AccR: accountEntity.setStatus(LOCKED)\n                        Note over ATE, AccR: Persisted atomically with the DECLINED event at commit\n                    end\n                else fraud approved\n                    ATE -&gt;&gt; AccR: account.reserve(amount, currency)\n                    alt sufficient available balance\n                        ATE -&gt;&gt; AccR: flush() %% fail fast on DB constraints\n                        ATE -&gt;&gt; ATE: build AUTHORISED\n                    else insufficient funds\n                        Note over ATE: InsufficientFundException caught -&lt;br/&gt;account left untouched, authorisation still persisted\n                        ATE -&gt;&gt; ATE: build DECLINED&lt;br/&gt;(reason INSUFFICIENT_FUNDS)\n                    else concurrent account-version conflict&lt;br/&gt;(different idempotency key)\n                        ATE --&gt;&gt; AS: throw AccountConcurrencyConflictException\n                    end\n                end\n\n                ATE -&gt;&gt; AR: saveAndFlush(authorisation&lt;br/&gt;AUTHORISED/DECLINED)\n                ATE -&gt;&gt; AER: saveAndFlush(event&lt;br/&gt;AUTHORISATION_AUTHORISED&lt;br/&gt;DECLINED)\n                ATE -&gt;&gt; OES: enqueueAuthorisation(...,&lt;br/&gt;OperationType.AUTHORISE)\n                OES -&gt;&gt; OES: build AUTHORISE&lt;br/&gt;payload map\n                OES -&gt;&gt; OES: save outbox event&lt;br/&gt;(status NEW)\n                ATE --&gt;&gt; AS: AuthorisationResponse\n            end\n\n            alt Concurrent idempotency insert race\n                AS -&gt;&gt; AR: findByAccountIdAndAuthoriseEventTypesAndIdempotencyKey(...)\n                alt Matching winner payload\n                    AR --&gt;&gt; AS: AuthorisationEntity\n                    AS --&gt;&gt; AC: recovered idempotent response\n                else Mismatch or missing row\n                    AS --&gt;&gt; AC: IdempotencyConflictException /&lt;br/&gt;IllegalStateException\n                end\n            else Concurrent account-version conflict&lt;br/&gt;(different idempotency key)\n                AS --&gt;&gt; AC: 409 Conflict (retry hint)\n            else No race\n                AS -&gt;&gt; Cache: store response (TTL)\n                AS --&gt;&gt; AC: AuthorisationResponse\n            end\n        end\n    end\n\n    AC --&gt;&gt; Client: 200 OK&lt;br/&gt;/ error&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EHgCbapy31KYafkXcnWO-159">
