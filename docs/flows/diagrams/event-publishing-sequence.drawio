        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\tautonumber\n\tparticipant Sch as OutboxScheduler&lt;br/&gt;(auth-service)\n\tparticipant OES as OutboxEvent&lt;br/&gt;ServiceImpl\n\tparticipant ORepo as OutboxEvent&lt;br/&gt;Repository\n\tparticipant Pub as OutboxKafka&lt;br/&gt;Publisher\n\tparticipant Kafka as Kafka topic:&lt;br/&gt;auth.events\n\n\tloop every outbox.publisher.delay-ms\n\t\tSch-&gt;&gt;OES: publishNextBatch(batchSize)\n\t\tOES-&gt;&gt;ORepo: reclaimStalePublishing(now,&lt;br/&gt;NEW, PUBLISHING)\n\t\tOES-&gt;&gt;ORepo: findNextBatch(NEW, now, page)\n\n\t\tloop each outbox event\n\t\t\tOES-&gt;&gt;ORepo: claimNewEvent(eventId,&lt;br/&gt;claimedAt, claimUntil,&lt;br/&gt;PUBLISHING, NEW)\n\t\t\talt claim succeeded\n\t\t\t\tOES-&gt;&gt;Pub: publishAsync(outboxEvent)\n\t\t\t\tPub-&gt;&gt;Kafka: send(payload + headers)\n\n\t\t\t\talt publish success\n\t\t\t\t\tOES-&gt;&gt;ORepo: markPublished(eventId,&lt;br/&gt;now, PUBLISHED)\n\t\t\t\telse publish failure\n\t\t\t\t\talt backoffPolicy.shouldFail(nextRetryCount)\n\t\t\t\t\t\tOES-&gt;&gt;ORepo: markFailed(eventId,&lt;br/&gt;retryCount, error, FAILED)\n\t\t\t\t\telse retry later\n\t\t\t\t\t\tOES-&gt;&gt;ORepo: markRetry(eventId,&lt;br/&gt;retryCount, nextAttemptAt,&lt;br/&gt;error, NEW)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\telse claim lost\n\t\t\t\tNote over OES,ORepo: another poller instance already claimed it\n\t\t\tend\n\t\tend\n\tend\n\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OIQvXJK3jxkEPSnIfM8--48">
