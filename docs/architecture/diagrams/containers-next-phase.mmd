flowchart TB
    Client(["Browser / Swagger / Postman / Load Test"])
    Ops(["Admin / Ops user"])
    Processor[["External Payment Processor /<br/>Card Network (simulated, planned)"]]

    subgraph Platform["Payment Platform (system boundary)"]
        direction TB

        subgraph Frontends["Frontend applications (internal, planned)"]
            direction LR
            UI["Customer Web App<br/>(React/Angular SPA)<br/>OIDC client: customer scope<br/>(planned)"]
            Backoffice["Admin / Back-office Web App<br/>(React/Angular SPA)<br/>OIDC client: admin scope<br/>SSO/VPN-restricted<br/>(planned)"]
        end

        subgraph Edge["Edge / Perimeter (planned)"]
            direction LR
            Gateway["API Gateway<br/>(routing, rate limiting,<br/>scope enforcement)"]
        end

        subgraph Services["Application services (internal)"]
            direction LR
            Auth["auth-service :9000<br/>(accounts, authorise,<br/>capture, reverse, outbox)"]
            Fraud["fraud-service :9010<br/>(risk decisioning)"]
            Ledger["ledger-service :9020<br/>(event projection,<br/>read-only query API)"]
            Recon["reconciliation-service<br/>(ledger vs. account/<br/>external drift detection)<br/>(planned)"]
            Notify["notification-service<br/>(email/SMS/webhook<br/>on lifecycle events)<br/>(planned)"]
        end

        subgraph Infra["Platform infrastructure (internal)"]
            direction TB

            subgraph DataInfra["Data infrastructure"]
                direction LR
                Postgres[("PostgreSQL<br/>auth_db / fraud_db / ledger_db")]
                Redis[("Redis<br/>idempotency cache +<br/>velocity counters")]
                KafkaTopic[("Kafka<br/>auth.events (+ DLT)")]
                Blob[("Object Storage<br/>(receipts, statements, KYC docs)<br/>(planned)")]
            end

            subgraph PlatformSecurity["Platform / security services (planned)"]
                direction LR
                IdP["Identity Provider<br/>(OAuth2/OIDC, e.g. Keycloak)"]
                Config[("Config / Secrets Store<br/>(e.g. Vault)")]
            end
        end

        subgraph Obs["Observability Stack (internal, separate boundary)"]
            direction LR
            OTel["OTel Collector"]
            Tempo["Tempo"]
            Prometheus["Prometheus"]
            Grafana["Grafana"]
        end
    end

